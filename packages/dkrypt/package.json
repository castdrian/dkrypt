{
  "name": "dkrypt-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --isolate --parallel=2 --max-concurrency=4 --timeout=15000",
    "db:migrate:dry-run": "bun scripts/migration-dry-run.ts",
    "load-test": "bun scripts/load-test.ts",
    "stripe:seed": "bun scripts/seed-stripe-catalog.ts",
    "stripe:webhook": "bun scripts/configure-stripe-webhook.ts",
    "stripe:verify": "bun scripts/verify-stripe.ts",
    "build:web": "cd web && bun install --frozen-lockfile && bun run build",
    "typecheck:web": "cd web && bun install --frozen-lockfile && bun run typecheck",
    "clients:generate": "bun scripts/generate-clients.ts",
    "api:mock": "bun scripts/mock-api.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@scalar/fastify-api-reference": "^1.75.1",
    "@simplewebauthn/server": "^14.0.2",
    "@sinclair/typebox": "^0.34.52",
    "adm-zip": "^0.6.1",
    "bplist-parser": "^0.5.0",
    "cron-parser": "^5",
    "discord-api-types": "^0.38.57",
    "fastify": "^5.12.7",
    "iso-3166": "4.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.0",
    "plist": "^5.0.0",
    "safe-regex2": "^5.1.2",
    "ssh2": "^1.17.0",
    "stripe": "^23.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.4.3",
    "fast-check": "^4.10.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.11",
    "undici": "6.29.1",
    "@scalar/json-magic": {
      ".": "0.15.2",
      "undici": "7.30.1"
    }
  }
}
