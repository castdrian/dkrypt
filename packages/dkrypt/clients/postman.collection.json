{
  "info": {
    "name": "dkrypt Public API",
    "description": "Public API-key operations for dkrypt decrypt jobs and IPA artifacts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET /v1/decrypt",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/decrypt",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "decrypt"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /v1/jobs/{id}",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/jobs/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "jobs",
            "{{id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST /v1/decrypts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/decrypts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "decrypts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bundleId\": \"com.example.app\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "POST /v1/testflight/decrypt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/testflight/decrypt",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "testflight",
            "decrypt"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bundleId\": \"com.example.app\",\n  \"appId\": 123456789,\n  \"build\": {\n    \"id\": 987654321,\n    \"cfBundleShortVersion\": \"1.0\",\n    \"cfBundleVersion\": \"42\",\n    \"bundleId\": \"com.example.app\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "GET /v1/artifacts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/artifacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "artifacts"
          ]
        }
      },
      "response": []
