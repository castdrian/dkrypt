      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/artifacts/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "artifacts",
            "{{id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /v1/artifacts/{id}/file",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/artifacts/{{id}}/file",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "artifacts",
            "{{id}}",
