    {
      "name": "POST /v1/jobs/status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/jobs/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "jobs",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ids\": [\n    \"{{jobId}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "GET /v1/jobs/{id}/wait",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/jobs/{{id}}/wait",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "jobs",
            "{{id}}",
            "wait"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /v1/jobs/{id}/events",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/jobs/{{id}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "jobs",
            "{{id}}",
            "events"
          ]
        }
      },
      "response": []
    }
  ]
}
