<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.adrian.autoinstall.device-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/libexec/autoinstall-device-agent</string>
	</array>
	<key>UserName</key>
	<string>mobile</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/var/mobile/Library/Logs/autoinstall-device-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/Logs/autoinstall-device-agent.err.log</string>
</dict>
</plist>
