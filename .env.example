# --- auth ---
# Master key for manual API calls. `openssl rand -hex 32`
API_KEY=

SESSION_SIGNING_SECRET=
SESSION_SIGNING_SECRET_PREVIOUS=
BACKUP_MANIFEST_SECRET=
BACKUP_MANIFEST_SECRET_PREVIOUS=

PUBLIC_BASE_URL=https://ipa.dylib.dev
TRUSTED_PROXY_ADDRESSES=loopback
ABUSE_SIGNAL_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IPAPI_IS_KEY=
IPINFO_TOKEN=
ABUSE_BLOCKED_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,10minutemail.com,temp-mail.org,tempmail.com,yopmail.com,maildrop.cc,getnada.com,dispostable.com,trashmail.com
FREE_NETWORK_DECRYPT_LIMIT=60
FREE_ANONYMOUS_NETWORK_DECRYPT_LIMIT=24
FREE_ADDRESS_DECRYPT_LIMIT=12
FREE_ANONYMOUS_ADDRESS_DECRYPT_LIMIT=6

# Root/recovery password for the dashboard (at https://<PUBLIC_BASE_URL>/) -
# independent from API_KEY so either can be rotated without touching the
# other. Logs in as an implicit admin; normal users should sign in via
# GitHub OAuth below instead. `openssl rand -hex 24`
ADMIN_PASSWORD=
ADMIN_PASSWORD_PREVIOUS=

STATE_DIR=/data/state
STATE_DATABASE_FILE=dkrypt.sqlite
STATE_DB_BUSY_TIMEOUT_MS=5000
STATE_DB_MIGRATION_DRY_RUN=false

DEVICE_SSH_KEY_PATH=/run/dkrypt/device_ssh_key
DEVICE_SSH_USER=mobile
DEVICE_SSH_PORT=22
DEVICE_TRANSPORT=auto
APPSTORE_OFFLINE_DECRYPT_ENABLED=true
APPSTORE_OFFLINE_FAIRPLAY_AUTHORIZED=true
APPSTORE_OFFLINE_MAX_WORKERS=1
APPSTORE_OFFLINE_ATTEMPT_TIMEOUT_SECONDS=900
APPSTORE_OFFLINE_STALL_TIMEOUT_SECONDS=300
APPSTORE_OFFLINE_FALLBACK_RESERVE_SECONDS=180
APPSTORE_OFFLINE_CIRCUIT_FAILURE_THRESHOLD=3
APPSTORE_OFFLINE_CIRCUIT_COOLDOWN_SECONDS=300
APPSTORE_OFFLINE_DECRYPTOR_BIN=
APPSTORE_OFFLINE_VAULT_KEY=
DEVICE_BRIDGE_SOCKET=/run/dkrypt/device-bridge.sock
DEVICE_BRIDGE_SECRET=
DEVICE_BRIDGE_SECRET_PREVIOUS=
DEVICE_MUX_SOCKET=/run/dkrypt/usbmuxd.sock
DEVICE_PAIRING_STORE=/data/state/device-pairing
NETMUXD_BIN=/usr/local/bin/netmuxd

# Persistent decrypted IPA storage. The default is 200 GiB and uses LRU eviction.
ARTIFACT_DIR=/data/artifacts
ARTIFACT_MAX_BYTES=214748364800

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_SECRET_PREVIOUS=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_SECRET_PREVIOUS=
APPLE_OAUTH_SERVICE_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_BASE64=

# Optional - grants configured dashboard roles to anyone who holds a matching role in a Discord
# guild, checked on every Discord login. Needs a bot (separate from the OAuth app above) invited
# to the guild - no privileged intents required, just the token below. Which guild and which
# Discord role maps to which dashboard role are both configured in Settings -> Roles, not here.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_PREVIOUS=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_WEBHOOK_URL=https://ipa.dylib.dev/v1/stripe/webhook
STRIPE_REGULAR_PRICE_ID=
STRIPE_PRIORITY_PRICE_ID=
STRIPE_API_PRICE_ID=
STRIPE_PRIORITY_API_PRICE_ID=
STRIPE_ACCESS_PRICE_ID=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_DEVELOPER_PRICE_ID=
STRIPE_UNLIMITED_PRICE_ID=
STRIPE_UNLIMITED_PRIORITY_PRICE_ID=
STRIPE_DECRYPT_CREDIT_PRICE_ID=
STRIPE_DECRYPT_CREDIT_QUANTITY=10
BILLING_GIFT_ENCRYPTION_SECRET=
BILLING_CATALOG_ROLLOUT=off
BILLING_CATALOG_CANARY_USER_IDS=
STRIPE_TAX_CODE=

CRYPTO_BILLING_ENABLED=false
CRYPTO_BILLING_POLL_INTERVAL_SECONDS=300
CRYPTO_DUNNING_GRACE_HOURS=72
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_API_KEY_PREVIOUS=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_SECRET_PREVIOUS=
NOWPAYMENTS_API_BASE_URL=https://api.nowpayments.io/v1
NOWPAYMENTS_ENVIRONMENT=live
NOWPAYMENTS_SUPPORTED_ASSETS=USDC
NOWPAYMENTS_DEFAULT_ASSET=USDC
NOWPAYMENTS_OUTCOME_CURRENCY=USDCBASE
NOWPAYMENTS_PRICE_CURRENCY=EUR

# --- job lifecycle ---
# How long GET /v1/decrypt holds the connection waiting for the file before
# falling back to a 202 with a status URL to poll instead.
JOB_MAX_WAIT_SECONDS=1800
JOB_MAX_RETRIES=1
JOB_PROCESS_GRACE_SECONDS=10
# How long finished job records are kept around for status polling.
JOB_RETENTION_MINUTES=1440

# Optional Discord-webhook-shaped URL notified on: a decrypt failure that
# Also editable from the dashboard.
NOTIFY_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_SECRET_PREVIOUS=
QUEUE_SLO_MINUTES=30

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_SERVICE_NAME=dkrypt
OTEL_SAMPLE_RATE=1
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=64
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_SCHEDULE_DELAY=5000

# --- email notifications ---
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank to disable email notifications
# entirely. When set, users can opt into email alongside push notifications
# from the dashboard's account menu (job completion, device alerts, key
# expiry) - sent to the email address linked via GitHub/Discord OAuth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASS_PREVIOUS=
SMTP_FROM=dkrypt <dkrypt@dylib.dev>
